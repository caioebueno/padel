# Asset pipeline: raw AI downloads and hand-off files (the manifest records their source)
SourceArt/_raw/
SourceArt/_incoming/
__pycache__/

# MetaHuman players (docs/decisions/0006-metahuman-players.md): each one is hundreds of MB to
# GBs of binary content under the MetaHuman licence, so they stay on the machine that made
# them. Data/PlayerBodies.json names them; a clone without them shows the placeholders.
/Content/MetaHumans/
/Content/Padel/Characters/MetaHumans/
# Epic's UE5 mannequin, copied from the engine's Third Person template by
# Tools/AssetPipeline/unreal/animation_setup.py as the source of the locomotion clips.
/Content/Characters/
# Video footwork (docs/decisions/0012-video-footwork.md): built from the WHAM results with the
# SMPL body, under SMPL's licence, so it stays on the machine that made it like the source in
# SourceArt/_incoming/Footwork/. Animation.json lists the database as an extra: a clone
# without it keeps the Game Animation Sample set.
/Content/Padel/Animations/MotionMatching/Footwork/
/Content/Padel/Animations/Retarget/IK_PadelFootwork.uasset
/Content/Padel/Animations/Retarget/RTG_Footwork_To_Placeholder.uasset
# The movement restart (docs/decisions/0014-sample-locomotion.md): Tools/AssetPipeline/unreal/gasp_migrate.py
# copies the Game Animation Sample's locomotion set (under /Content/Characters/ and /Content/MetaHumans/,
# above) with the sample content it depends on (foley sounds, anim notifies), which stays local too.
/Content/Audio/
/Content/Blueprints/
/Content/Misc/
